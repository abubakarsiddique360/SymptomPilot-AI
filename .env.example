# SymptomPilot configuration — every value is optional.
# Copy to `.env` only if you need to change a default. Never commit a real `.env`.
#
# The app runs with no configuration at all: BM25 retrieval plus a deterministic
# extractive answer composer. Nothing below is required to start.

# --- Model provider -----------------------------------------------------
# auto = try Ollama first, then an OpenAI-compatible endpoint, then no LLM.
# options: auto | ollama | openai | none
SYMPTOMPILOT_LLM_PROVIDER=auto
SYMPTOMPILOT_OLLAMA_URL=http://127.0.0.1:11434
SYMPTOMPILOT_OLLAMA_MODEL=llama3.2
SYMPTOMPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
SYMPTOMPILOT_OPENAI_API_KEY=
SYMPTOMPILOT_OPENAI_MODEL=gpt-4o-mini
SYMPTOMPILOT_LLM_TIMEOUT=45

# --- Retrieval ----------------------------------------------------------
# Dense retrieval is optional and needs a local Ollama embedding model.
# options: auto | ollama | none
SYMPTOMPILOT_EMBED_BACKEND=auto
SYMPTOMPILOT_EMBED_MODEL=nomic-embed-text
SYMPTOMPILOT_BM25_WEIGHT=0.65
SYMPTOMPILOT_TOP_K=5
SYMPTOMPILOT_ABSTAIN_THRESHOLD=0.15
SYMPTOMPILOT_MIN_CHUNK_SCORE=0.05

# --- Storage ------------------------------------------------------------
SYMPTOMPILOT_DB_PATH=var/symptompilot.db
SYMPTOMPILOT_KB_DIR=knowledge

# --- Web ----------------------------------------------------------------
SYMPTOMPILOT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
